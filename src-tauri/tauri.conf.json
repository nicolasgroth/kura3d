{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kurra3D Studio",
  "version": "0.5.0",
  "identifier": "com.nicolasgroth.kura3d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kurra3D Studio — Estudio de Modelado 3D",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "ISGROTH — Innovación y Soluciones GROTH",
    "copyright": "Copyright (c) 2026 Nicolás Groth — ISGROTH (Innovación y Soluciones GROTH)"
  }
}
