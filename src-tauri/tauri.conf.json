{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kura3D",
  "version": "1.0.0",
  "identifier": "com.nicolasgroth.kura3d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kura3D — Estudio de Modelado 3D",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "ISGROTH — Innovación y Soluciones GROTH",
    "copyright": "Copyright (c) 2026 Nicolás Groth — ISGROTH (Innovación y Soluciones GROTH)"
  }
}
