{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacidades mínimas de la ventana principal de Kurra Studio: diálogos de abrir/guardar/confirmar, lectura y escritura solo de rutas elegidas por el usuario y comandos propios declarados en build.rs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:deny-default",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:allow-write-file",
    "allow-open-kura-project",
    "allow-save-kura-project",
    "allow-recent-projects-list",
    "allow-recent-project-open",
    "allow-recent-projects-remove",
    "allow-recent-projects-clear",
    "allow-recent-projects-set-enabled",
    "allow-ai-key-status",
    "allow-ai-key-set",
    "allow-ai-key-delete",
    "allow-mcp-token-get",
    "allow-mcp-token-set",
    "allow-mcp-token-delete",
    "allow-ai-http-request",
    "allow-ai-http-cancel",
    "allow-ai-allowed-hosts-get",
    "allow-ai-allowed-hosts-set"
  ]
}
