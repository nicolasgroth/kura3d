{
  "format": "kura.recipe/1",
  "id": "kura.placa-enchufe",
  "version": "0.1.0",
  "kura": ">=0.8.0",
  "title": "$t:title",
  "description": "$t:description",
  "author": "Kura3D",
  "license": "MIT",
  "category": "hogar",
  "params": [
    { "id": "modules", "type": "integer", "unit": "count", "min": 1, "max": 3, "default": 1, "label": "$t:modules" },
    { "id": "mw", "type": "number", "unit": "mm", "min": 10, "max": 80, "default": 45, "label": "$t:mw" },
    { "id": "winw", "type": "number", "unit": "mm", "min": 5, "max": "=p.mw - 2", "default": 40, "label": "$t:winw" },
    { "id": "winh", "type": "number", "unit": "mm", "min": 5, "max": 120, "default": 45, "label": "$t:winh" },
    { "id": "ph", "type": "number", "unit": "mm", "min": 40, "max": 200, "default": 80, "label": "$t:ph" },
    { "id": "margin", "type": "number", "unit": "mm", "min": 4, "max": 40, "default": 18, "label": "$t:margin" },
    { "id": "t", "type": "number", "unit": "mm", "min": 1.6, "max": 6, "default": 3, "label": "$t:t" },
    { "id": "screwAxis", "type": "choice", "default": "x", "label": "$t:screwAxis",
      "options": [{ "value": "x", "label": "$t:sides" }, { "value": "y", "label": "$t:topBottom" }] },
    { "id": "spacing", "type": "number", "unit": "mm", "min": 20, "max": 250, "default": "=p.modules*p.mw + 15", "label": "$t:spacing" },
    { "id": "screw", "type": "number", "unit": "mm", "min": 2, "max": 5, "default": 3.5, "label": "$t:screw" }
  ],
  "presets": [
    { "id": "cl", "label": "$t:cl", "verified": false, "values": { "mw": 45, "winw": 40, "winh": 45, "ph": 80, "screwAxis": "x", "screw": 3.5 } },
    { "id": "it", "label": "$t:it", "verified": false, "values": { "mw": 22.5, "winw": 21, "winh": 45, "ph": 80, "screwAxis": "x", "screw": 3.5 } },
    { "id": "es", "label": "$t:es", "verified": false, "values": { "modules": 1, "mw": 50, "winw": 50, "winh": 50, "ph": 80, "screwAxis": "x", "spacing": 60 } },
    { "id": "us", "label": "$t:us", "verified": false, "values": { "modules": 1, "mw": 70, "winw": 35, "winh": 67, "ph": 114, "screwAxis": "y", "spacing": 97 } }
  ],
  "derive": { "pw": "=p.modules*p.mw + 2*p.margin", "sh": "=p.spacing/2" },
  "rules": [
    { "level": "error", "when": "=p.winh >= p.ph - 8", "message": "$t:winTooTall", "focus": "winh" },
    { "level": "error", "when": "=p.screwAxis == 'x' && d.sh + p.screw >= d.pw/2", "message": "$t:screwOut", "focus": "spacing" },
    { "level": "error", "when": "=p.screwAxis == 'x' && d.sh - p.screw <= p.modules*p.mw/2", "message": "$t:screwInWindow", "focus": "spacing" },
    { "level": "info", "when": "=true", "message": "$t:unverified" }
  ],
  "steps": [
    { "id": "plate", "op": "create_primitive", "args": { "type": "box", "params": { "width": "=d.pw", "depth": "=p.ph", "height": "=p.t", "cornerRadius": 4 } } },
    { "id": "win", "op": "create_primitive",
      "pattern": { "kind": "linear", "count": "=p.modules", "step": ["=p.mw", 0, 0], "centered": true, "max": 3 },
      "args": { "type": "box", "position": ["=x", 0, -1], "params": { "width": "=p.winw", "depth": "=p.winh", "height": "=p.t + 2" } } },
    { "id": "holes", "op": "create_primitive",
      "pattern": { "kind": "points", "max": 2, "points": [
        ["=p.screwAxis == 'x' ? -d.sh : 0", "=p.screwAxis == 'y' ? -d.sh : 0", -1],
        ["=p.screwAxis == 'x' ? d.sh : 0", "=p.screwAxis == 'y' ? d.sh : 0", -1]] },
      "args": { "type": "cylinder", "position": ["=x", "=y", "=z"], "params": { "radius": "=p.screw/2 + 0.2", "height": "=p.t + 2" } } },
    { "id": "sinks", "op": "create_primitive",
      "pattern": { "kind": "points", "max": 2, "points": [
        ["=p.screwAxis == 'x' ? -d.sh : 0", "=p.screwAxis == 'y' ? -d.sh : 0", "=p.t + 0.01"],
        ["=p.screwAxis == 'x' ? d.sh : 0", "=p.screwAxis == 'y' ? d.sh : 0", "=p.t + 0.01"]] },
      "args": { "type": "cone", "rotation": [180, 0, 0], "position": ["=x", "=y", "=z"], "params": { "radius": "=p.screw", "height": "=p.screw" } } },
    { "id": "out", "op": "boolean_operation", "args": { "op": "subtract", "target": "@plate", "tools": ["@win", "@holes", "@sinks"] } }
  ],
  "outputs": [{ "ref": "@out", "name": "$t:outPlate" }],
  "strings": {
    "es": {
      "title": "Placa de enchufe",
      "description": "Placa de 1 a 3 módulos. Todas las medidas son de ejemplo, por verificar; no corresponden a ninguna norma.",
      "modules": "Módulos", "mw": "Ancho de módulo", "winw": "Ancho de ventana", "winh": "Alto de ventana", "ph": "Alto de placa",
      "margin": "Margen lateral", "t": "Grosor", "screwAxis": "Tornillos", "sides": "A los lados", "topBottom": "Arriba y abajo",
      "spacing": "Distancia entre tornillos", "screw": "Diámetro de tornillo",
      "cl": "Chile (por verificar)", "it": "Italia (por verificar)", "es": "España (por verificar)", "us": "EE. UU. (por verificar)",
      "winTooTall": "La ventana es casi tan alta como la placa.", "screwOut": "Los tornillos quedan fuera de la placa.",
      "screwInWindow": "Los tornillos caen dentro de la ventana.",
      "unverified": "Medidas de ejemplo: mide tu caja antes de imprimir.", "outPlate": "Placa"
    },
    "en": {
      "title": "Wall plate",
      "description": "Plate with 1 to 3 modules. All sizes are examples still to be verified; they follow no standard.",
      "modules": "Modules", "mw": "Module width", "winw": "Window width", "winh": "Window height", "ph": "Plate height",
      "margin": "Side margin", "t": "Thickness", "screwAxis": "Screws", "sides": "On the sides", "topBottom": "Top and bottom",
      "spacing": "Screw spacing", "screw": "Screw diameter",
      "cl": "Chile (to verify)", "it": "Italy (to verify)", "es": "Spain (to verify)", "us": "USA (to verify)",
      "winTooTall": "The window is almost as tall as the plate.", "screwOut": "The screws fall outside the plate.",
      "screwInWindow": "The screws fall inside the window.",
      "unverified": "Example sizes: measure your box before printing.", "outPlate": "Plate"
    }
  }
}
