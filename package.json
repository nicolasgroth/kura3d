{
  "name": "kura3d",
  "version": "0.5.0",
  "description": "Kurra Studio — Modelador 3D nativo y web de alto rendimiento para creación e impresión 3D, con motor Manifold CSG, servidor MCP nativo y chat IA multi-proveedor. Desarrollado para ISGROTH (Innovación y Soluciones GROTH).",
  "author": "Nicolás Groth <ngroth@gmail.com> (ISGROTH — Innovación y Soluciones GROTH)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasgroth/kurra3d.git"
  },
  "homepage": "https://github.com/nicolasgroth/kurra3d#readme",
  "bugs": {
    "url": "https://github.com/nicolasgroth/kurra3d/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:perf": "node scripts/test-perf.mjs",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "mcp:build": "npm --prefix mcp-server run build",
    "mcp:start": "npm --prefix mcp-server run start",
    "mcp:test": "npm --prefix mcp-server run test",
    "docs:capturas": "playwright test -c playwright.docs.config.ts",
    "docs:mcp": "node scripts/docs-mcp-tabla.mjs",
    "docs:enlaces": "node scripts/docs-comprobar-enlaces.mjs",
    "recetas:schema": "node scripts/recetas-schema.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "jsep": "1.6.0",
    "lucide-react": "^1.78.0",
    "manifold-3d": "^3.5.5",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "three-mesh-bvh": "$three-mesh-bvh"
  }
}
